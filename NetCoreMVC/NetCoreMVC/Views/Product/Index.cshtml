@model MyAppMVC.Models.ProductViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container">
    <div class="row">

        <!-- DANH MỤC -->
        <div class="col-md-3">
            <h3>DANH MỤC</h3>

            <ul class="list-group">

                @foreach (var category in Model.Categories)
                {
                    <li class="list-group-item">
                        <a href="@Url.Action("Index", "Product", new { categoryId = category.Id })">
                            @category.Name
                        </a>
                    </li>
                }

            </ul>

            <br />

         
        </div>


        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="col-md-9">

            <h2>Danh sách sản phẩm</h2>

            <div class="row">

                @foreach (var product in Model.Products)
                {
                    <div class="col-md-4 mb-4">

                        <div class="card">

                            <img src="@product.Image"
                                 class="card-img-top"
                                  />

                            <div class="card-body">

                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                                <p>
                                    <del>
                                        Giá: @product.Price.ToString("N0") 
                                    </del>
                                </p>

                                <p>
                                    Giá: @product.SalePrice.ToString("N0") 
                                </p>

                                <a href="@Url.Action("Detail", "Product",
                                                                            new { id = product.Id })"
                                   class="btn btn-success btn-sm w-100">
                                    Chi tiết
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>
</div>